# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Your deployed URL (used for OAuth redirects and live links)
NEXT_PUBLIC_SITE_URL=https://<your-app>.vercel.app
# anthropic | none  ("none" forces the scripted offline mode)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
# Optional: a faster model for the clarifying questions on /new (falls back to LLM_MODEL at low effort)
LLM_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
# Optional: where the "View the code" links point (defaults to the public repo)
NEXT_PUBLIC_REPO_URL=https://github.com/aryansaharan/architect-2
# Optional: GitHub token with no scopes (raises import rate limit 60 -> 5000/h)
GITHUB_TOKEN=
# Supabase → Project Settings → API Keys → secret key. Server only: never prefix it with NEXT_PUBLIC
SUPABASE_SECRET_KEY=sb_secret_...
# Model spend cap per guest, in USD per 24 hours (0 means guests never trigger a model call)
LLM_DAILY_USD_GUEST=0
# Model spend cap per signed-in member, in USD per 24 hours
LLM_DAILY_USD_MEMBER=1
# Model spend cap for the whole site, in USD per 24 hours
LLM_DAILY_USD_SITE=10
# A long random string; Vercel Cron sends it as "Authorization: Bearer ..." to /api/cron/cleanup
CRON_SECRET=
# A long random string mixed into hashed IP addresses (rate limits, abuse reports)
RATE_LIMIT_SALT=
